# ================================================================
# .env.example  —  React Frontend (Vite)
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production with real secrets.
# ================================================================

# URL of your deployed ASP.NET Core API (no trailing slash)
VITE_API_URL=https://<YOUR_API_HOST>/api

# URL of your deployed sessions-backend (Node.js/Express)
VITE_NODE_API_URL=https://<YOUR_SESSIONS_BACKEND_HOST>
