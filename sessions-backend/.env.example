# ============================================================
# .env.example  —  sessions-backend (Node.js / Express)
# Copy this to .env and fill in real values for local dev.
# Set these as environment variables on your hosting platform.
# NEVER commit .env with real secrets.
# ============================================================

# MongoDB connection string (leave empty to use in-memory store)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studysmart_sessions

# Port the server listens on (hosting platforms override this automatically)
PORT=5000

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=https://<YOUR_FRONTEND_URL>,https://localhost:63349

# JWT secret (must match ReactApp1.Server Jwt:Key if sharing tokens)
JWT_SECRET=<YOUR_JWT_SECRET>

# Gmail credentials for sending OTP emails
EMAIL_USER=<YOUR_GMAIL_ADDRESS>
EMAIL_PASS=<YOUR_GMAIL_APP_PASSWORD>
