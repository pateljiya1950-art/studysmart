{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Conn": "Data Source=(localdb)\\mssqllocaldb;Initial Catalog=studentdb;Integrated Security=True;Trust Server Certificate=True"
  },
  "Jwt": {
    "Key": "<SET_VIA_ENV_VAR_Jwt__Key>",
    "Issuer": "StudySmartAPI",
    "Audience": "StudySmartClient"
  },
  "EmailSettings": {
    "EmailUser": "<SET_VIA_ENV_VAR_EmailSettings__EmailUser>",
    "EmailPass": "<SET_VIA_ENV_VAR_EmailSettings__EmailPass>"
  },
  "AiSettings": {
    "OpenAIKey": "<SET_VIA_ENV_VAR_AiSettings__OpenAIKey>"
  },
  "AllowedOrigins": [
    "https://localhost:63349"
  ]
}